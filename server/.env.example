PORT=3000
# Postgres — for local dev, run one with `docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`
# then use: postgresql://postgres:postgres@localhost:5432/mode_crm
DATABASE_URL="postgresql://user:password@localhost:5432/mode_crm"
JWT_SECRET=your-secret-key-change-in-production
NODE_ENV=development
# Only needed if the client is served from a different origin than this API (not the case
# for the production single-service deploy, where the client is served by this same server).
FRONTEND_URL=http://localhost:5173
