generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("sales")
  phone       String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads         Lead[]
  tasks         Task[]
  activities    Activity[]
  tickets       Ticket[]
  loginHistory  LoginHistory[]
  personalGoals PersonalGoal[]
  assignedTasks ManagerTask[]  @relation("ManagerTaskAssignee")
  createdTasks  ManagerTask[]  @relation("ManagerTaskCreator")
  dailySummaries DailySummary[]
  requisitions  Requisition[]  @relation("RequisitionRequester")
  approvals     Requisition[]  @relation("RequisitionApprover")
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedInAt DateTime @default(now())
}

model Lead {
  id                String   @id @default(uuid())
  name              String
  company           String
  email             String
  phone             String?
  serviceInterested String
  source            String
  budget            Float    @default(0)
  currency          String   @default("NGN")
  notes             String?
  designation       String?
  address           String?
  status            String   @default("new-lead")
  estimatedValue    Float    @default(0)
  probability       Int      @default(20)
  expectedCloseDate DateTime?
  assignedTo        String?
  assignedUser      User?    @relation(fields: [assignedTo], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  position  String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  website   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  clientName  String
  serviceType String
  status      String   @default("pending")
  startDate   DateTime?
  endDate     DateTime?
  budget        Float    @default(0)
  currency      String   @default("NGN")
  progress      Int      @default(0)
  assignedTeam  String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks      Task[]
  milestones Milestone[]
}

model Task {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("pending")
  assignedTo  String?
  assignedUser User?   @relation(fields: [assignedTo], references: [id])
  dueDate     DateTime?
  priority    String   @default("medium")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Service {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  basePrice   Float    @default(0)
  currency    String   @default("NGN")
  isActive    Boolean  @default(true)
  features    String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HostingAccount {
  id               String   @id @default(uuid())
  clientName       String
  domainName       String
  registrationDate DateTime?
  expiryDate       DateTime
  hostingPlan      String   @default("starter")
  sslStatus        String   @default("none")
  autoRenew        Boolean  @default(false)
  status           String   @default("active")
  monthlyFee       Float    @default(0)
  currency         String   @default("NGN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  clientName    String
  clientEmail   String
  items         String   @default("[]")
  subtotal      Float    @default(0)
  tax           Float    @default(0)
  total         Float    @default(0)
  amountPaid    Float    @default(0)
  currency      String   @default("NGN")
  status        String   @default("draft")
  issueDate     DateTime @default(now())
  dueDate       DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String   @default("NGN")
  method    String
  reference String?
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Ticket {
  id          String   @id @default(uuid())
  clientName  String
  subject     String
  description String?
  status      String   @default("open")
  priority    String   @default("medium")
  assignedTo  String?
  assignedUser User?   @relation(fields: [assignedTo], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id          String   @id @default(uuid())
  type        String
  description String
  entityType  String
  entityId    String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  userName    String
  createdAt   DateTime @default(now())
}

model EmailCampaign {
  id             String   @id @default(uuid())
  name           String
  type           String
  status         String   @default("draft")
  recipientCount Int      @default(0)
  sentCount      Int      @default(0)
  openRate       Float    @default(0)
  clickRate      Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PersonalGoal {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  description String?
  targetDate DateTime?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ManagerTask {
  id          String    @id @default(uuid())
  title       String
  description String?
  assignedTo  String
  assignee    User      @relation("ManagerTaskAssignee", fields: [assignedTo], references: [id], onDelete: Cascade)
  assignedBy  String
  creator     User      @relation("ManagerTaskCreator", fields: [assignedBy], references: [id])
  dueDate     DateTime?
  priority    String    @default("medium")
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DailySummary {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  note      String
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Requisition {
  id          String    @id @default(uuid())
  requestedBy String
  requester   User      @relation("RequisitionRequester", fields: [requestedBy], references: [id])
  amount      Float
  currency    String    @default("NGN")
  category    String
  reason      String
  status      String    @default("pending")
  approvedBy  String?
  approver    User?     @relation("RequisitionApprover", fields: [approvedBy], references: [id])
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
